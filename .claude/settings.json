{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin claude-dev)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git push origin --delete*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)"
    ]
  }
}
